# =====================================================
# AuditAI .env
# LLM: AWS Bedrock (Claude). Embeddings run LOCALLY (no key needed).
# =====================================================

# --- AWS Bedrock auth ---
# Local dev: an IAM user's keys with bedrock:InvokeModel* on the model ids below.
# Production: leave these BLANK and let the ECS task role supply credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# PostgreSQL Database (must have pgvector extension installed)
# Local dev: point at a local Postgres or the docker-compose `auditai-pg` container.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PG_PASSWORD@localhost:5432/auditai_db
# Amazon RDS / Aurora example (note the asyncpg driver + no sslmode in the URL):
# DATABASE_URL=postgresql+asyncpg://prod_aura:YOUR_DB_PASSWORD@one-audit-aura-instance-1.cjwpxsh7zcyc.eu-west-1.rds.amazonaws.com:5432/aura

# --- Database TLS (Amazon RDS / Aurora) ---
# Leave DB_SSLMODE empty (or "disable") for a local non-TLS Postgres.
# For RDS use "verify-full" with the AWS global CA bundle. Download it once:
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSLMODE=verify-full
# DB_SSL_ROOT_CERT=./global-bundle.pem

# --- Production DB (set in ECS task definition / Secrets Manager — DO NOT commit) ---
# DATABASE_URL=postgresql+asyncpg://prod_aura:FROM_SECRETS_MANAGER@one-audit-aura.cluster-cjwpxsh7zcyc.eu-west-1.rds.amazonaws.com:5432/aura
# DB_SSL_MODE=verify-full
# DB_SSL_ROOT_CERT=/etc/ssl/certs/rds-global-bundle.pem   # baked into the image

# JWT Authentication
JWT_SECRET_KEY=a-very-long-random-secret-string-minimum-32-characters
JWT_EXPIRE_HOURS=8

# Initial Admin Account (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads

# Bedrock models — cross-region inference-profile ids ("eu." prefix). Each is a
# comma-separated failover list (left-most first; a throttled id cools down).
#   smart = generation/chat/TB-tail · fast = intent/expansion/translation
# Enable model access in the Bedrock console (eu-west-1) and grant the IAM
# principal bedrock:InvokeModel* for whatever ids you set. Defaults are
# Sonnet 4.5 (smart) / Haiku 4.5 (fast) — both ACTIVE in eu-west-1.
BEDROCK_MODEL_SMART=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_FAST=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Seconds to skip a model after it throttles.   # BEDROCK_MODEL_COOLDOWN_SEC=60
# Per-call retry budget on throttle before failover. # BEDROCK_MAX_RETRIES=2
# Embedding model. multilingual-e5-small (384-dim) supports Arabic + English.
# English-only alternatives at the same 384-dim: BAAI/bge-small-en-v1.5, all-MiniLM-L6-v2.
# Changing the model requires re-embedding all stored vectors (reembed_all.py).
# If you pick a model with a different dimension (e.g. bge-m3 = 1024), also update
# EMBEDDING_DIMENSIONS and run a pgvector column migration + index rebuild.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# Cross-encoder reranker. Multilingual (mMARCO, incl. Arabic) so Arabic KB
# chunks are re-scored correctly. Scores at query time — changing it needs NO
# re-embedding, just rebuild the image to bake the model. English-only, lighter
# alternative: cross-encoder/ms-marco-MiniLM-L-6-v2. Disable with USE_RERANKER=false.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- 1audit integration (copilot data callbacks) ---
# Base URL of 1audit-be's internal copilot API. In Docker, reach the host's
# 1audit-be via host.docker.internal instead of localhost.
ONEAUDIT_BASE_URL=http://localhost:5030/api/v1/internal

# Short-TTL (seconds) cache for the file-mode chat's data fetches, so a burst of
# questions reuses one fetch instead of re-querying 1audit-be each time. The
# grant is re-validated once per request, so caching never bypasses auth. 0 = off.
# COPILOT_DATA_CACHE_TTL_SEC=120

# --- Security: file encryption at rest ---
# Generate a real key for production with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT_UPLOADS=true
FILE_ENCRYPTION_KEY=

# --- Security: rate limits (slowapi syntax) ---
RATE_LIMIT_ASK=30/hour;200/day
RATE_LIMIT_SESSION_START=10/minute
RATE_LIMIT_ADMIN_LOGIN=5/minute;30/hour
RATE_LIMIT_ADMIN_UPLOAD=20/hour

# --- Security: per-session daily question cap ---
MAX_QUESTIONS_PER_SESSION_DAY=100
MAX_QUESTION_CHARS=4000

# --- Tesseract OCR (only needed for image / scanned-PDF uploads) ---
# The backend auto-detects standard install paths. Only set this if
# Tesseract is installed somewhere unusual.
# Example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Per-org AI usage cap (optional; defaults in config.py) ---
# Monthly AI-credit allowance per org. Credits are model-weighted (1 ≈ $0.001),
# so the default below is ~$50/month per org. Metering writes ai_usage_ledger;
# enforcement 402s the 3 user features, degrades TB Tier-3 to Tier-2.
# AI_CREDIT_CAP_ENABLED=true                  # false = meter only, never block
# AI_USAGE_METERING_ENABLED=true
# AI_MONTHLY_CREDIT_ALLOWANCE_DEFAULT=50000
# AI_CREDIT_FLOOR=0
